/* VaultDrive home enhance — sections / badges / drawer / PWA polish */
:root {
  --home-accent: #2dd4bf;
  --home-badge-live: #2dd4bf;
  --home-badge-none: #737373;
  --home-badge-dead: #f87171;
  --home-badge-mixed: #fbbf24;
}

.home-rail {
  margin: 0 0 28px;
  padding: 0 4px;
}
.home-rail + .home-rail { margin-top: 8px; }
.home-rail-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}
.home-rail-head h2 {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 650;
  letter-spacing: 0.02em;
  color: var(--text-primary);
}
.home-rail-head p {
  margin: 2px 0 0;
  font-size: 0.78rem;
  color: var(--text-muted);
}
.home-rail-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.home-personal {
  background: linear-gradient(135deg, rgba(45,212,191,0.08), rgba(255,255,255,0.02));
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 14px;
  padding: 14px 16px;
  margin: 0 4px 22px;
}
.home-personal.hidden { display: none; }
.home-personal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.home-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--text-secondary);
  font-size: 0.82rem;
  cursor: pointer;
  transition: background .15s, border-color .15s, color .15s;
}
.home-pill:hover {
  background: rgba(45,212,191,0.12);
  border-color: rgba(45,212,191,0.35);
  color: var(--text-primary);
}
.home-pill strong { color: var(--home-accent); font-weight: 650; }

.home-hscroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}
.home-hscroll::-webkit-scrollbar { height: 4px; }
.home-hscroll::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.12);
  border-radius: 4px;
}
.home-chip-card {
  flex: 0 0 auto;
  width: 92px;
  scroll-snap-align: start;
  border-radius: 10px;
  background: var(--bg-card);
  border: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
  cursor: pointer;
  transition: transform .18s ease, border-color .18s;
}
.home-chip-card:hover {
  transform: translateY(-2px);
  border-color: rgba(45,212,191,0.35);
}
.home-chip-card .thumb {
  aspect-ratio: 2/3;
  background: #111;
  position: relative;
  overflow: hidden;
}
.home-chip-card .thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.home-chip-card .meta {
  padding: 6px 6px 8px;
}
.home-chip-card .meta .t {
  font-size: 0.68rem;
  color: var(--text-primary);
  line-height: 1.25;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.home-chip-card .meta .s {
  margin-top: 4px;
  font-size: 0.68rem;
  color: var(--text-muted);
}

.home-hot-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.home-hot-chip {
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--text-secondary);
  font-size: 0.8rem;
  cursor: pointer;
}
.home-hot-chip:hover {
  color: var(--text-primary);
  border-color: rgba(45,212,191,0.4);
}
.home-hot-chip .n {
  margin-left: 6px;
  color: var(--text-muted);
  font-size: 0.72rem;
}

/* 海报角标：收藏按钮正下方，不挡底部片名 */
.poster-badges {
  position: absolute;
  left: 8px;
  right: auto;
  top: 46px;
  bottom: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  z-index: 4;
  pointer-events: none;
}
.poster-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 7px;
  border-radius: 6px;
  font-size: 0.65rem;
  font-weight: 650;
  letter-spacing: 0.02em;
  backdrop-filter: blur(8px);
  background: rgba(0,0,0,0.78);
  color: #fff;
  max-width: 120px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 2px 8px rgba(0,0,0,0.35);
}
.poster-badge.live { color: var(--home-badge-live); }
.poster-badge.none { color: var(--home-badge-none); }
.poster-badge.dead { color: var(--home-badge-dead); }
.poster-badge.mixed { color: var(--home-badge-mixed); }

/* 详情抽屉 */
.detail-drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.62);
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease;
}
.detail-drawer-mask.open {
  opacity: 1;
  pointer-events: auto;
}
.detail-drawer {
  position: fixed;
  top: 0;
  right: 0;
  height: 100%;
  width: min(440px, 100vw);
  background: #0a0a0a;
  border-left: 1px solid rgba(255,255,255,0.08);
  z-index: 91;
  transform: translateX(104%);
  transition: transform .28s cubic-bezier(.2,.8,.2,1);
  display: flex;
  flex-direction: column;
  box-shadow: -20px 0 60px rgba(0,0,0,0.55);
}
.detail-drawer.open { transform: translateX(0); }
.detail-drawer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 18px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.detail-drawer-head h3 {
  margin: 0;
  font-size: 1.15rem;
  line-height: 1.35;
  color: var(--text-primary);
}
.detail-drawer-head .sub {
  margin-top: 6px;
  font-size: 0.78rem;
  color: var(--text-muted);
}
.detail-drawer-close {
  border: 0;
  background: rgba(255,255,255,0.06);
  color: var(--text-secondary);
  width: 36px;
  height: 36px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 1.1rem;
  flex-shrink: 0;
}
.detail-drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 12px 16px 28px;
}
.detail-link {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 12px;
  border-radius: 12px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 8px;
}
.detail-link .src {
  font-size: 0.72rem;
  font-weight: 650;
  padding: 4px 8px;
  border-radius: 6px;
  background: rgba(45,212,191,0.12);
  color: var(--home-accent);
}
.detail-link .info .t {
  font-size: 0.82rem;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.detail-link .info .m {
  margin-top: 3px;
  font-size: 0.7rem;
  color: var(--text-muted);
}
.detail-link .go {
  font-size: 0.75rem;
  color: var(--home-accent);
  text-decoration: none;
  padding: 6px 10px;
  border-radius: 8px;
  background: rgba(45,212,191,0.1);
}
.detail-link.is-dead {
  opacity: 0.55;
}
.detail-empty {
  text-align: center;
  padding: 40px 12px;
  color: var(--text-muted);
  font-size: 0.9rem;
}
.detail-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin: 8px 0 16px;
}
.detail-actions button {
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.04);
  color: var(--text-secondary);
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 0.8rem;
  cursor: pointer;
}
.detail-actions button.primary {
  background: rgba(45,212,191,0.16);
  border-color: rgba(45,212,191,0.35);
  color: var(--home-accent);
}

/* 搜索增强：历史 + 网盘筛选 + 联想 */
.home-search-tools {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: min(560px, 100%);
}
.home-source-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
}
.home-source-filters .sf {
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  color: var(--text-muted);
  background: rgba(0,0,0,0.35);
  border: 1px solid rgba(255,255,255,0.08);
  cursor: pointer;
}
.home-source-filters .sf.active {
  color: #041210;
  background: var(--home-accent);
  border-color: transparent;
  font-weight: 650;
}
.home-ac-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 6px);
  background: #121212;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  z-index: 20;
  overflow: hidden;
  display: none;
  text-align: left;
  box-shadow: 0 16px 40px rgba(0,0,0,0.45);
}
.home-ac-panel.open { display: block; }
.home-ac-item {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 14px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  cursor: pointer;
}
.home-ac-item:hover, .home-ac-item.active {
  background: rgba(45,212,191,0.1);
  color: var(--text-primary);
}
.home-search-box { position: relative; }
.home-hist-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
}
.home-hist-chip {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  color: var(--text-muted);
  border: 1px dashed rgba(255,255,255,0.14);
  cursor: pointer;
}
.home-hist-chip:hover { color: var(--text-primary); }

.home-skel-row {
  display: flex;
  gap: 12px;
  overflow: hidden;
}
.home-skel {
  flex: 0 0 92px;
  height: 160px;
  border-radius: 10px;
  background: linear-gradient(90deg, #141414, #1c1c1c, #141414);
  background-size: 200% 100%;
  animation: homeSkel 1.2s ease-in-out infinite;
}
@keyframes homeSkel {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.home-chip-ph {
  display: grid;
  place-items: center;
  height: 100%;
  background: linear-gradient(160deg, #1a1a1a, #101010);
  color: rgba(255,255,255,0.35);
  font-size: 1.1rem;
  font-weight: 650;
  letter-spacing: 0.04em;
}
.detail-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0 0 12px;
}
.detail-filters button {
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.04);
  color: var(--text-muted);
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 0.72rem;
  cursor: pointer;
}
.detail-filters button.active {
  color: #041210;
  background: var(--home-accent);
  border-color: transparent;
  font-weight: 650;
}

@media (max-width: 720px) {
  .home-chip-card { width: 84px; }
  .detail-drawer { width: 100vw; }
  .home-personal { margin-left: 0; margin-right: 0; }
}

/* PWA install hint */
.pwa-hint {
  position: fixed;
  left: 12px;
  right: 12px;
  bottom: 16px;
  z-index: 80;
  display: none;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(18,18,18,0.94);
  border: 1px solid rgba(45,212,191,0.3);
  backdrop-filter: blur(10px);
}
.pwa-hint.show { display: flex; }
.pwa-hint button {
  border: 0;
  border-radius: 10px;
  padding: 8px 12px;
  cursor: pointer;
  font-size: 0.8rem;
}
.pwa-hint .ok {
  background: var(--home-accent);
  color: #041210;
  font-weight: 650;
}
.pwa-hint .no {
  background: transparent;
  color: var(--text-muted);
}
