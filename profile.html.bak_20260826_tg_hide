<script>

var _bindCodeCountdown = 0;
var _bindCodeTimer = null;

async function sendBindEmailCode() {
  const email = (document.getElementById('newBindEmail')?.value || '').trim();
  if (!email || !email.includes('@')) return showToast('请输入有效邮箱', 'error');
  if (_bindCodeCountdown > 0) return;

  const btn = document.getElementById('btnSendBindCode');
  btn.disabled = true;
  btn.textContent = '发送中…';

  try {
    const r = await fetch('/api/auth/email/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, action: 'bind' })
    });
    const d = await r.json();
    if (r.ok && d.ok) {
      showToast('验证码已发送至新邮箱');
      _bindCodeCountdown = 60;
      btn.textContent = _bindCodeCountdown + 's';
      if (_bindCodeTimer) clearInterval(_bindCodeTimer);
      _bindCodeTimer = setInterval(function() {
        _bindCodeCountdown--;
        if (_bindCodeCountdown <= 0) {
          clearInterval(_bindCodeTimer);
          btn.disabled = false;
          btn.textContent = '重新获取';
        } else {
          btn.textContent = _bindCodeCountdown + 's';
        }
      }, 1000);
      document.getElementById('newBindCode')?.focus();
    } else {
      showToast(d.error || '发送失败', 'error');
      btn.disabled = false;
      btn.textContent = '获取验证码';
    }
  } catch(e) {
    showToast('网络错误', 'error');
    btn.disabled = false;
    btn.textContent = '获取验证码';
  }
}

async function submitBindEmail() {
  const email = (document.getElementById('newBindEmail')?.value || '').trim();
  const code = (document.getElementById('newBindCode')?.value || '').trim();
  if (!email || !code) return showToast('请填写完整邮箱与验证码', 'error');

  try {
    const r = await fetch('/api/user/bind-email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, code: code })
    });
    const d = await r.json();
    if (r.ok && d.ok) {
      showToast(d.message || '邮箱绑定成功！');
      document.getElementById('newBindEmail').value = '';
      document.getElementById('newBindCode').value = '';
      loadUserMe();
    } else {
      showToast(d.error || '绑定失败', 'error');
    }
  } catch(e) {
    showToast('请求失败', 'error');
  }
}

</script>
