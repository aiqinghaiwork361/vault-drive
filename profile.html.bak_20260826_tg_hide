async function removeSubscription(id) {
  await fetch(`/api/subscriptions/${id}`, { method: 'DELETE' });
  showToast('已移除监控');
  loadSubscriptions();
}

async function loadPointLogs() {
  const container = document.getElementById('pointLogsList');
  document.getElementById('pointsTabTotal').textContent = CURRENT_USER ? (CURRENT_USER.points || 0) : 0;
  try {
    const r = await fetch('/api/user/points/logs');
    const d = await r.json();
    const items = d.items || [];
    if (!items || !items.length) {
      container.innerHTML = `<div class="empty-tip">暂无积分变动流水</div>`;
      return;
    }
    container.innerHTML = `
      <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead>
          <tr style="border-bottom:1px solid var(--hairline);color:var(--ink-subtle);text-align:left;">
            <th style="padding:10px 8px;font-weight:500;">事项</th>
            <th style="padding:10px 8px;font-weight:500;">变动分值</th>
            <th style="padding:10px 8px;font-weight:500;">变动后余额</th>
            <th style="padding:10px 8px;font-weight:500;">记录时间</th>
          </tr>
        </thead>
        <tbody>
          ${items.map(it => {
            const isPlus = it.change_amount > 0;
            const changeColor = isPlus ? 'var(--teal)' : 'var(--semantic-danger)';
            const changeStr = isPlus ? `+${it.change_amount}` : `${it.change_amount}`;
            return `
              <tr style="border-bottom:1px solid var(--hairline);">
                <td style="padding:12px 8px;color:var(--ink);font-weight:500;">${it.remark || it.action}</td>
                <td style="padding:12px 8px;font-family:var(--font-mono);font-weight:600;color:${changeColor};">${changeStr}</td>
                <td style="padding:12px 8px;font-family:var(--font-mono);color:var(--ink-muted);">${it.balance_after}</td>
                <td style="padding:12px 8px;color:var(--ink-tertiary);font-size:12px;font-family:var(--font-mono);">${(it.created_at || '').substring(0,16)}</td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    `;
  } catch(e) {
    container.innerHTML = `<div class="empty-tip">加载失败</div>`;
  }
}

async function saveProfile() {
  const nick = document.getElementById('setNickname').value.trim();
  const email = document.getElementById('setEmail').value.trim();
  const r = await fetch('/api/user/profile', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ nickname: nick, email: email })
  });
  const d = await r.json();
  if (r.ok && d.ok) {
    showToast(d.message || '资料已更新');
    loadUserMe();
  } else {
    showToast(d.error || '更新失败');
  }
}

async function changePassword() {
  const oldP = document.getElementById('oldPass').value.trim();
  const newP = document.getElementById('newPass').value.trim();
  if (!oldP || !newP) return showToast('请输入完整密码');
  const r = await fetch('/api/user/change-password', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ old_password: oldP, new_password: newP })
  });
  const d = await r.json();
  if (r.ok && d.ok) {
    showToast(d.message || '密码修改成功');
    document.getElementById('oldPass').value = '';
    document.getElementById('newPass').value = '';
  } else {
    showToast(d.error || '修改失败');
  }
}

async function startTgBind() {
  const hint = document.getElementById('tgBindHint');
  hint.style.display = 'block';
  hint.textContent = '生成绑定码中…';
  const r = await fetch('/api/user/telegram/bind-code', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  });
  const d = await r.json();
  if (r.ok && d.ok) {
    hint.innerHTML = `私聊 <a href="${d.bot_link || '#'}" target="_blank" style="color:var(--primary);">@${d.bot_username}</a> 发送: <code style="color:var(--teal);font-weight:600;font-family:var(--font-mono);margin-left:4px;">${d.code}</code>`;
  } else {
    hint.textContent = d.error || '生成失败';
  }
}

async function unbindTelegram() {
  if (!confirm('确定解绑 Telegram？')) return;
  await fetch('/api/user/telegram/unbind', { method: 'POST' });
  showToast('已解绑 Telegram');
