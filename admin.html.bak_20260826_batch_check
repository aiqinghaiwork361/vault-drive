<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>后台管理 · VaultDrive</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,800&family=Sora:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #000000;
  --bg-deep: #000000;
  --bg-surface: #0a0a0a;
  --bg-card: #121212;
  --bg-card-hover: #1a1a1a;
  --surface: rgba(255,255,255,0.04);
  --surface-hover: rgba(255,255,255,0.08);
  --bg-glass: rgba(0,0,0,0.82);
  --green: #2dd4bf;
  --green-dim: #14b8a6;
  --green-glow: rgba(45,212,191,0.28);
  --amber: #e5e7eb;
  --amber-dim: #9ca3af;
  --amber-glow: rgba(229,231,235,0.12);
  --red: #f87171;
  --red-dim: #ef4444;
  --blue: var(--green);
  --purple: #94a3b8;
  --pink: #94a3b8;
  --accent-green: var(--green);
  --accent-red: var(--red);
  --accent-purple: var(--purple);
  --accent-gold: #fbbf24;
  --text-primary: #f5f5f5;
  --text-secondary: #a3a3a3;
  --text-muted: #737373;
  --border: rgba(255,255,255,0.10);
  --border-subtle: rgba(255,255,255,0.06);
  --border-medium: rgba(255,255,255,0.16);
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 18px;
  --font-display: 'Fraunces','Noto Sans SC',Georgia,serif;
  --font-body: 'Sora','Noto Sans SC',sans-serif;
  --shadow-card: 0 1px 0 rgba(255,255,255,0.04), 0 12px 32px rgba(0,0,0,0.55);
  --shadow-hover: 0 2px 0 rgba(255,255,255,0.04), 0 20px 48px rgba(0,0,0,0.65);
  --shadow-glow: 0 0 0 3px rgba(45,212,191,0.22);
  --header-h: 56px;
  --sidebar-w: 220px;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0;font-family:var(--font-body);background:var(--bg);color:var(--text-primary);-webkit-font-smoothing:antialiased;overflow-x:hidden}
::selection{background:rgba(45,212,191,0.28);color:var(--text-primary)}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.14);border-radius:999px}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,0.28)}
input,select,textarea{font-family:var(--font-body);background:var(--bg-card);border:1px solid var(--border);color:var(--text-primary);border-radius:var(--radius-md);padding:8px 12px;outline:none;font-size:0.85rem}
input:focus,select:focus,textarea:focus{border-color:var(--green);box-shadow:var(--shadow-glow)}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
a{color:var(--green);text-decoration:none}

.app{display:grid;grid-template-columns:var(--sidebar-w) 1fr;min-height:100vh}
.side{position:sticky;top:0;height:100vh;overflow-y:auto;background:var(--bg-surface);border-right:1px solid var(--border-subtle);padding:16px 12px;display:flex;flex-direction:column;gap:6px;z-index:20}
.side-logo{display:flex;align-items:center;gap:10px;padding:4px 10px 14px;border-bottom:1px solid var(--border-subtle);margin-bottom:8px}
.side-logo .ico{width:28px;height:28px;background:var(--green);border-radius:8px;display:grid;place-items:center;font-size:12px;color:#000;font-weight:900}
.side-logo .txt{font-family:var(--font-display);font-weight:700;font-size:1.05rem;color:var(--text-primary);letter-spacing:-0.02em}
.nav-group{margin-bottom:6px}
.nav-group-title{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;color:var(--text-muted);font-size:0.68rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:600;cursor:pointer;border-radius:var(--radius-md);user-select:none}
.nav-group-title:hover{color:var(--text-secondary)}
.nav-group-title::after{content:'▾';font-size:0.8rem;transition:transform 0.2s}
.nav-group.collapsed .nav-group-title::after{transform:rotate(-90deg)}
.nav-group.collapsed .nav-items{display:none}
.nav-items{display:flex;flex-direction:column;gap:2px;padding-left:6px}
.nav{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:var(--radius-md);font-size:0.8rem;color:var(--text-secondary);cursor:pointer;transition:all 0.15s;white-space:nowrap}
.nav:hover{background:rgba(45,212,191,0.08);color:var(--green)}
.nav.active{background:rgba(45,212,191,0.12);color:var(--green);font-weight:500}
.nav .ic{width:18px;text-align:center;opacity:0.7;font-size:0.9rem}
.side-footer{margin-top:auto;padding-top:12px;border-top:1px solid var(--border-subtle);display:flex;flex-direction:column;gap:2px}

.main{min-height:100vh;overflow-y:auto;padding:24px 28px;background:var(--bg)}
.hdr{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid var(--border-subtle);flex-wrap:wrap}
.hdr h1{font-family:var(--font-display);font-size:1.45rem;font-weight:700;letter-spacing:-0.02em;margin:0}
.hdr-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}

.card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:20px}
.kpi-card{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:16px;position:relative;overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;border-top:3px solid var(--green)}
.kpi-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}
.kpi-card:nth-child(2){border-top-color:var(--amber)}
.kpi-card:nth-child(3){border-top-color:var(--red)}
.kpi-card:nth-child(4){border-top-color:var(--purple)}
.kpi-card:nth-child(5){border-top-color:var(--accent-gold)}
.kpi-card:nth-child(6){border-top-color:var(--green)}
.kpi-card .lbl{font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:6px;font-weight:600}
.kpi-card .val{font-size:1.6rem;font-weight:700;color:var(--text-primary);font-family:var(--font-display);line-height:1.2}
.kpi-card .sub{font-size:0.72rem;color:var(--text-muted);margin-top:4px}

.growth-progress{margin-bottom:16px}
.growth-meta{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:8px;font-size:0.82rem}
.growth-meta .chat{color:var(--green);font-weight:600}
.growth-meta .nums{color:var(--text-secondary)}
.growth-bar{height:10px;background:rgba(255,255,255,0.06);border-radius:999px;overflow:hidden}
.growth-bar-fill{height:100%;width:0;background:linear-gradient(90deg,var(--green),#34d399);border-radius:999px;transition:width 0.4s}
.growth-bar-fill.warn{background:linear-gradient(90deg,var(--accent-gold),#f87171)}
.growth-hint{margin-top:8px;font-size:0.75rem;color:var(--text-muted);line-height:1.5}
.growth-hint.warn{color:var(--accent-gold)}
.growth-hint.ok{color:var(--green)}
#growthKpi{margin-bottom:0}

.section-card{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:18px;margin-bottom:16px}
.section-card h3{margin:0 0 14px;font-size:1rem;font-family:var(--font-display);letter-spacing:-0.02em;display:flex;align-items:center;justify-content:space-between;gap:12px}
.section-card h3 .hint{font-size:0.72rem;color:var(--text-muted);font-family:var(--font-body);font-weight:400}

.chart-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-bottom:16px}
.chart-box{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:16px}
.chart-box h4{margin:0 0 12px;font-size:0.85rem;color:var(--text-secondary);font-weight:600}
.chart-canvas{height:180px;position:relative}
.mini-bar{display:flex;align-items:flex-end;gap:3px;height:100%;padding:0 4px}
.mini-bar-item{flex:1;background:var(--green);border-radius:2px 2px 0 0;opacity:0.8;min-height:2px;transition:opacity 0.2s}
.mini-bar-item:hover{opacity:1}
.pie-list{display:flex;flex-direction:column;gap:8px;max-height:200px;overflow-y:auto}
.pie-row{display:flex;align-items:center;gap:10px;font-size:0.8rem}
.pie-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.pie-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pie-count{font-weight:600;color:var(--text-primary)}
.pie-pct{color:var(--text-muted);font-size:0.75rem}

.tbl-wrap{overflow-x:auto;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);background:var(--bg-card)}
table{width:100%;border-collapse:collapse;font-size:0.82rem}
th{padding:10px 12px;text-align:left;color:var(--text-muted);font-weight:600;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.04em;border-bottom:1px solid var(--border-subtle);white-space:nowrap;background:var(--bg-surface)}
td{padding:10px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-secondary);vertical-align:middle}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,0.02)}
.td-title{max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-primary)}
.td-url{max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.75rem;color:var(--text-muted)}
.td-actions{display:flex;gap:6px;flex-wrap:nowrap}

.badge{display:inline-flex;align-items:center;padding:3px 8px;border-radius:999px;font-size:0.7rem;font-weight:600;white-space:nowrap}
.badge-g{background:rgba(45,212,191,0.12);color:var(--green);border:1px solid rgba(45,212,191,0.25)}
.badge-y{background:rgba(251,191,36,0.12);color:var(--accent-gold);border:1px solid rgba(251,191,36,0.25)}
.badge-r{background:rgba(248,113,113,0.12);color:var(--red);border:1px solid rgba(248,113,113,0.25)}
.badge-b{background:rgba(88,166,255,0.12);color:#58a6ff;border:1px solid rgba(88,166,255,0.25)}
.badge-d{background:var(--bg-surface);color:var(--text-muted);border:1px solid var(--border-subtle)}

.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:0.82rem;font-weight:600;transition:all 0.2s;background:var(--bg-card);border:1px solid var(--border);color:var(--text-primary)}
.btn:hover{border-color:var(--green);color:var(--green);background:rgba(45,212,191,0.08)}
.btn-p{background:var(--green)!important;color:#000!important;border:1px solid var(--green)!important}
.btn-p:hover{background:var(--green-dim)!important;color:#000!important}
.btn-r{background:rgba(248,113,113,0.12)!important;color:var(--red)!important;border:1px solid rgba(248,113,113,0.35)!important}
.btn-r:hover{background:rgba(248,113,113,0.2)!important}
.btn-g{background:var(--bg-card)!important;color:var(--text-secondary)!important;border:1px solid var(--border-medium)!important}
.btn-g:hover{background:rgba(45,212,191,0.08)!important;border-color:var(--green)!important;color:var(--green)!important}
.btn-d{background:var(--bg-surface)!important;color:var(--text-muted)!important;border:1px solid var(--border-subtle)!important}
.btn-s{padding:5px 10px;font-size:0.75rem}
.btn:disabled{opacity:0.4;cursor:default}

.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.toolbar-left,.toolbar-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.search-box{display:flex;align-items:center;gap:6px;min-width:260px;max-width:400px;flex:1}
.search-box input{flex:1}
.filter-group{display:flex;align-items:center;gap:6px;flex-wrap:wrap}

.pagination{display:flex;align-items:center;justify-content:center;gap:6px;padding:16px;flex-wrap:wrap}
.pagination button{padding:6px 12px;background:var(--bg-surface);border:1px solid var(--border-subtle);color:var(--text-secondary);border-radius:8px;cursor:pointer;font-size:0.78rem}
.pagination button:hover:not(:disabled){border-color:var(--green);color:var(--green)}
.pagination button.current{background:var(--green);border-color:var(--green);color:#000;font-weight:600}
.pagination button:disabled{opacity:0.4;cursor:default}
.pagination .info{font-size:0.75rem;color:var(--text-muted);margin-left:8px}

.empty{padding:40px;text-align:center;color:var(--text-muted);font-size:0.85rem}

.form-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:14px}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group label{font-size:0.75rem;color:var(--text-secondary);font-weight:500}
.form-group small{font-size:0.7rem;color:var(--text-muted)}
.form-hint{font-size:0.72rem;color:var(--text-muted);margin-top:-8px;margin-bottom:12px}

.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
.modal.show{display:flex}
.modal-c{background:var(--bg-card);border:1px solid var(--border-medium);border-radius:var(--radius-xl);padding:20px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-hover)}
.modal-c.wide{max-width:720px}
.modal-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.modal-hdr h3{margin:0;font-family:var(--font-display);font-size:1.1rem;letter-spacing:-0.02em}
.modal-ft{display:flex;justify-content:flex-end;gap:8px;margin-top:18px;padding-top:14px;border-top:1px solid var(--border-subtle)}

.toast-container{position:fixed;top:16px;right:16px;z-index:300;display:flex;flex-direction:column;gap:8px;max-width:320px}
.toast{background:var(--bg-card);border:1px solid var(--border-medium);border-left:3px solid var(--green);border-radius:var(--radius-md);padding:10px 14px;font-size:0.82rem;color:var(--text-primary);box-shadow:var(--shadow-card);animation:toastIn 0.25s ease;display:flex;align-items:center;justify-content:space-between;gap:10px}
.toast.error{border-left-color:var(--red)}
.toast.success{border-left-color:var(--green)}
.toast.info{border-left-color:var(--amber)}
.toast .close{cursor:pointer;color:var(--text-muted);font-size:1rem;line-height:1}
.toast .close:hover{color:var(--text-primary)}
@keyframes toastIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}

.status-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-subtle);font-size:0.8rem}
.status-row:last-child{border-bottom:none}
.status-row .ok{color:var(--green);font-weight:500}
.status-row .warn{color:var(--accent-gold);font-weight:500}
.status-row .err{color:var(--red);font-weight:500}

.log-line{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border-subtle);font-size:0.78rem;align-items:flex-start}
.log-line:last-child{border-bottom:none}
.log-line .time{color:var(--text-muted);white-space:nowrap;font-size:0.72rem}
.log-line .user{background:var(--bg-surface);padding:2px 8px;border-radius:6px;color:var(--text-secondary);font-size:0.72rem;white-space:nowrap}
.log-line .action{color:var(--amber);min-width:80px;white-space:nowrap}
.log-line .detail{color:var(--text-secondary);flex:1;word-break:break-word}

.mobile-toggle{display:none;position:fixed;top:14px;left:14px;z-index:50;width:40px;height:40px;border-radius:var(--radius-md);background:var(--bg-card);border:1px solid var(--border-medium);color:var(--text-primary);align-items:center;justify-content:center;font-size:1.2rem}
.side-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:40}

@media(max-width:900px){
  .app{grid-template-columns:1fr}
  .side{position:fixed;left:0;transform:translateX(-100%);transition:transform 0.25s;box-shadow:var(--shadow-hover)}
  .side.open{transform:translateX(0)}
  .mobile-toggle{display:flex}
  .side-backdrop.show{display:block}
  .main{padding:70px 16px 24px}
  .chart-grid{grid-template-columns:1fr}
  .card-grid{grid-template-columns:repeat(2,1fr)}
  .toolbar{flex-direction:column;align-items:stretch}
  .search-box{max-width:none}
  .td-title,.td-url{max-width:120px}
}
</style>
</head>
<body>
<button class="mobile-toggle" onclick="toggleSidebar()">☰</button>
<div class="side-backdrop" onclick="toggleSidebar()"></div>
<div class="app">
  <div class="side" id="sidebar">
    <div class="side-logo"><div class="ico">V</div><div class="txt">VaultDrive</div></div>

    <div class="nav-group" data-group="overview">
      <div class="nav-group-title" onclick="toggleGroup(this)">概览</div>
      <div class="nav-items">
        <div class="nav active" onclick="showSec('dashboard')"><span class="ic">◉</span> 仪表盘</div>
      </div>
    </div>

    <div class="nav-group" data-group="content">
      <div class="nav-group-title" onclick="toggleGroup(this)">内容管理</div>
      <div class="nav-items">
        <div class="nav" onclick="showSec('resources')"><span class="ic">▣</span> 资源管理</div>
        <div class="nav" onclick="showSec('import')"><span class="ic">↓</span> 导入队列</div>
        <div class="nav" onclick="showSec('deadlinks')"><span class="ic">⌀</span> 死链清理</div>
        <div class="nav" onclick="showSec('duplicates')"><span class="ic">⧉</span> 资源去重</div>
        <div class="nav" onclick="showSec('sources')"><span class="ic">◈</span> 来源管理</div>
      </div>
    </div>

    <div class="nav-group" data-group="ops">
      <div class="nav-group-title" onclick="toggleGroup(this)">运营</div>
      <div class="nav-items">
        <div class="nav" onclick="showSec('announcements')"><span class="ic">※</span> 公告管理</div>
        <div class="nav" onclick="showSec('filters')"><span class="ic">⊘</span> 过滤词</div>
        <div class="nav" onclick="showSec('searchlogs')"><span class="ic">⌕</span> 搜索日志</div>
      </div>
    </div>

    <div class="nav-group" data-group="system">
      <div class="nav-group-title" onclick="toggleGroup(this)">系统</div>
      <div class="nav-items">
        <div class="nav" onclick="showSec('users')"><span class="ic">◇</span> 用户管理</div>
        <div class="nav" onclick="showSec('logs')"><span class="ic">☰</span> 操作日志</div>
        <div class="nav" onclick="showSec('apis')"><span class="ic">⬡</span> API 测试</div>
        <div class="nav" onclick="showSec('settings')"><span class="ic">⚙</span> 系统设置</div>
      </div>
    </div>

    <div class="side-footer">
      <div class="nav" onclick="window.location.href='/'"><span class="ic">←</span> 返回首页</div>
      <div class="nav" onclick="window.location.href='/logout?next=/login'"><span class="ic">⎋</span> 退出</div>
    </div>
  </div>

  <div class="main">
    <!-- 仪表盘 -->
    <div id="sec-dashboard">
      <div class="hdr"><h1>仪表盘</h1><div class="hdr-actions"><button class="btn btn-g btn-s" onclick="loadDashboard()">↻ 刷新</button></div></div>
      <div class="card-grid" id="kpiGrid">
        <div class="kpi-card"><div class="lbl">总资源</div><div class="val" id="sTotal">-</div><div class="sub" id="sTotalSub">-</div></div>
        <div class="kpi-card"><div class="lbl">今日新增</div><div class="val" id="sTodayAdd">-</div><div class="sub">24h 入库</div></div>
        <div class="kpi-card"><div class="lbl">死链</div><div class="val" id="sDead">-</div><div class="sub" id="sDeadSub">-</div></div>
        <div class="kpi-card"><div class="lbl">待导入</div><div class="val" id="sQueue">-</div><div class="sub">队列</div></div>
        <div class="kpi-card"><div class="lbl">累计访问</div><div class="val" id="sVisits">-</div><div class="sub">总 PV</div></div>
        <div class="kpi-card"><div class="lbl">今日搜索</div><div class="val" id="sSearches">-</div><div class="sub" id="sSearchesSub">-</div></div>
      </div>

      <div class="section-card" id="growthCard">
        <h3>引流监测 <span class="hint">现阶段只做进群和打开率 · 全站免费 · 暂不变现</span></h3>
        <div class="growth-progress">
          <div class="growth-meta">
            <span class="chat" id="gChat">必加群</span>
            <span class="nums" id="gProgressLbl">— / 10,000</span>
          </div>
          <div class="growth-bar"><div class="growth-bar-fill" id="gBar"></div></div>
          <div class="growth-hint" id="gHint">加载中…</div>
        </div>
        <div class="card-grid" id="growthKpi">
