  document.getElementById('logViewer').innerHTML=filtered.length?filtered.map(l=>`<div class="log-line"><span class="time">${(l.created_at||'').substring(0,19)}</span><span class="user">${esc(l.username||'系统')}</span><span class="action">${esc(labels[l.action]||l.action)}</span><span class="detail">${esc(l.detail||'')}</span></div>`).join(''):'<div class="empty">暂无日志</div>';
}
async function clearLogs(){if(!confirm('确定清空操作日志？'))return; const d=await api('/api/admin/logs/clear','POST');if(d.ok){show('已清空');loadLogs()}else show(d.error||'清空失败','error');}
function exportLogs(){
  const filter=document.getElementById('logFilter').value.trim().toLowerCase();
  const selectedAction=document.getElementById('logAction').value;
  const rows=logItems.filter(l=>{
    const txt=(l.action+' '+l.username+' '+l.detail+' '+(l.created_at||'')).toLowerCase();
    return (!filter||txt.includes(filter))&&(!selectedAction||l.action===selectedAction);
  });
  const csv=['时间,用户,操作,详情'];
  rows.forEach(r=>csv.push('"'+(r.created_at||'')+'","'+(r.username||'')+'","'+(r.action||'')+'","'+(r.detail||'')+'"'));
  const blob=new Blob([csv.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='logs_'+new Date().toISOString().slice(0,10)+'.csv'; a.click();
}

// 搜索日志
async function loadSearchLogs(){
  const d=await api('/api/admin/search_logs?per_page=50'); if(!d)return;
  const items=d.items||[];
  const filter=document.getElementById('searchlogFilter').value.trim().toLowerCase();
  const filtered=items.filter(x=>!filter||(x.keyword||'').toLowerCase().includes(filter)||(x.username||'').toLowerCase().includes(filter)||(x.ip||'').toLowerCase().includes(filter));
  document.getElementById('searchlogTbl').innerHTML=filtered.length?filtered.map(x=>`<tr><td>${x.id}</td><td>${esc(x.keyword||'')}</td><td>${esc(x.username||'-')}</td><td style="font-size:.72rem">${esc(x.ip||'')}</td><td style="font-size:.72rem">${(x.created_at||'').substring(0,19)}</td><td><button class="btn btn-r btn-s" onclick="deleteSearchLog(${x.id})">删除</button></td></tr>`).join(''):'<tr><td colspan="6" class="empty">暂无</td></tr>';
  const hot=await api('/api/admin/stats/dashboard');
  renderPieList('hotSearchList',(hot?.top_searches||[]).map(x=>({source:x.keyword,count:x.count})),false);
}
async function deleteSearchLog(id){const d=await api('/api/admin/search_logs/'+id,'DELETE');if(d.ok){show('已删除');loadSearchLogs()}else show(d.error||'删除失败','error');}
async function cleanupSearchLogs(){if(!confirm('确定清理过期搜索日志？'))return; const d=await api('/api/admin/search_logs/cleanup','POST');if(d.ok){show('已清理');loadSearchLogs()}else show(d.error||'清理失败','error');}

// 资源去重
async function loadDuplicates(){
  const by=document.getElementById('dupBy').value;
  const d=await api('/api/admin/duplicates?by='+by+'&limit=100'); if(!d)return;
  const items=d.items||[];
  document.getElementById('dupTbl').innerHTML=items.length?items.map(x=>{
    const sources=[...new Set((x.sources||'').split(',').filter(Boolean))].join(', ');
    return `<tr><td class="td-title" title="${esc(x.key||'')}">${esc((x.key||'').substring(0,60))}</td><td><span class="badge badge-y">${x.cnt}</span></td><td style="font-size:.72rem">${esc(sources)}</td><td style="font-size:.72rem">${esc((x.ids||'').substring(0,80))}</td><td><button class="btn btn-r btn-s" onclick="deleteDuplicateIds('${x.ids}')">删除重复</button></td></tr>`;
  }).join(''):'<tr><td colspan="5" class="empty">无重复资源</td></tr>';
}
async function deleteDuplicateIds(idsStr){
  const ids=(idsStr||'').split(',').map(x=>parseInt(x)).filter(Boolean);
  if(ids.length<=1){show('重复组至少需要保留一条','error');return}
  if(!confirm('该组有 '+ids.length+' 条重复，保留第一条、删除其余？'))return;
  const toDelete=ids.slice(1);
  const d=await api('/api/admin/resources/batch','POST',{action:'delete',ids:toDelete});
  if(d.ok){show('已删除 '+d.affected+' 条重复');loadDuplicates()}else show(d.error||'删除失败','error');
}
async function rebuildAggregate(){
  const el=document.getElementById('dupExtraResult');
  if(el) el.textContent='正在重建聚合表…';
  const d=await api('/api/admin/dedup/rebuild','POST',{only_multi:true,max_groups:5000});
  if(!d){if(el)el.textContent='失败';return}
  if(d.ok){show('聚合完成：'+d.groups+' 组'); if(el)el.textContent=`聚合 ${d.groups} 组 / 多源 ${d.multi_source_groups} / 成员 ${d.members_scanned}`;}
  else {show(d.error||'重建失败','error'); if(el)el.textContent=d.error||'失败';}
}
async function previewDataClean(){
  const el=document.getElementById("dupExtraResult");
  if(el) el.textContent="正在预览数据清洗…";
  const d=await api("/api/admin/cleaner/preview?limit=10");
  if(!d){if(el)el.textContent="预览失败";return;}
  if(el){
    const s=(d.samples||[]).map(x=>`[#${x.id}] ${x.title?.slice(0,18)}: (${x.old_type||"空"})->(${x.new_type||"不变"})`).join(" | ");
    el.textContent=`扫描 ${d.scanned} 条，可清洗 ${d.will_update} 条。示例：` + (s||"无");
  }
}
async function runDataClean(){
  const el=document.getElementById("dupExtraResult");
  if(!confirm("确认分批执行类型/画质数据清洗？")) return;
  if(el) el.textContent="正在执行批量清洗…";
  const d=await api("/api/admin/cleaner/run","POST",{batch_size:1000});
  if(!d){if(el)el.textContent="清洗失败";return;}
  if(d.ok){
    show(`清洗成功：更新了 ${d.updated} 条记录`);
    if(el) el.textContent=`本次清洗完成：扫描 ${d.scanned} 条，实际更新 ${d.updated} 条 (还有剩余: ${d.has_more ? "是" : "否"})`;
  } else {
    show(d.error||"清洗出错","error");
    if(el) el.textContent=d.error||"清洗出错";
  }
}
async function runSubPush(dry){
  const el=document.getElementById('dupExtraResult');
  if(el) el.textContent=dry?'预览订阅推送…':'执行订阅推送…';
  const d=await api('/api/admin/sub_push/check','POST',{dry_run:!!dry});
  if(!d){if(el)el.textContent='失败';return}
  if(d.dry_run){
    show('命中 '+d.hits+' 个订阅');
    if(el) el.textContent='预览命中 '+d.hits+'：'+JSON.stringify(d.preview||[]).slice(0,300);
  } else if(d.ok){
    show('推送完成 TG:'+(d.telegram_ok||0)+' 公告:'+(d.announcements||0));
    if(el) el.textContent=`hits=${d.hits} tg_ok=${d.telegram_ok} tg_fail=${d.telegram_fail} ann=${d.announcements}`;
  } else show(d.error||'推送失败','error');
}
async function previewAutoClean(){
  const days=parseInt(document.getElementById('acDays').value||'7',10);
  const d=await api('/api/admin/deadlinks/auto_clean/preview?days='+days);
  const el=document.getElementById('acResult');
  if(!d){if(el)el.textContent='预览失败';return}
  if(el) el.textContent=`将清理 ${d.total} 条（>${days}天失效）。样本：`+((d.samples||[]).slice(0,5).map(x=>x.id+':'+(x.title||'').slice(0,20)).join('；')||'无');
}
async function runAutoClean(){
  const days=parseInt(document.getElementById('acDays').value||'7',10);
  if(!confirm('确认删除失效超过 '+days+' 天的链接？'))return;
  const d=await api('/api/admin/deadlinks/auto_clean','POST',{days,limit:5000});
  const el=document.getElementById('acResult');
  if(d&&d.ok){show('已删除 '+d.deleted+' 条'); if(el)el.textContent='已删除 '+d.deleted+' 条'; loadDeadlinkStats();}
  else {show((d&&d.error)||'清理失败','error'); if(el)el.textContent=(d&&d.error)||'失败';}
}

// API测试
async function testApis(){
  show('正在测试…');
  const d=await api('/api/admin/test_apis'); if(!d)return;
  const results=d.results||[]; const ok=d.total_ok||0,err=d.total_error||0,lat=d.db_latency_ms||0;
  document.getElementById('apiDetail').innerHTML='<div style="margin-bottom:12px;display:flex;gap:12px"><span class="badge badge-g">正常: '+ok+'</span><span class="badge badge-r">异常: '+err+'</span><span class="badge badge-b">数据库: '+lat+'ms</span></div>'+results.map(a=>`<div class="pie-row" style="margin-bottom:6px"><span class="badge ${a.status==='ok'?'badge-g':'badge-r'}">${a.status==='ok'?'✓':'✗'}</span><span class="pie-name">${esc(a.method||'')} ${esc(a.path||'')}</span><span class="pie-pct">${a.ms||'-'}ms</span></div>`).join('');
  show('测试完成');
}

