async function deleteDeadlinks(){
  const source=document.getElementById('dlSourceFilter').value;
  const deadCount=parseInt(document.getElementById('dlDead').textContent.replace(/[^0-9]/g,''))||0;
  if(deadCount===0){show('没有死链可删除');return}
  const scope=source?`来源 "${source}" 的`:'全部';
  if(!confirm(`确定删除${scope} ${deadCount} 条死链？\n\n此操作不可恢复，请确认。`))return;
  const r=await api('/api/admin/deadlinks/delete','POST',{all:true,source:source||undefined});
  if(r.ok){show('已删除 '+r.deleted+' 条死链');loadDeadlinkStats()}else show(r.error||'删除失败','error');
}

// 用户
let meSuper=false, meId=0;
let _usersCache=[];
function _isAdminRole(role){const r=String(role||'').toLowerCase();return r==='admin'}
function _isSuperRole(role){const r=String(role||'').toLowerCase();return r==='superadmin'||r==='super'||r==='root'}
function _roleLabel(role){
  if(_isSuperRole(role)) return '超管';
  if(_isAdminRole(role)) return '管理员';
  return '用户';
}
async function loadUsers(){
  const q=(document.getElementById('userSearchInput')?.value||'').trim();
  const role=(document.getElementById('userRoleFilter')?.value||'').trim();
  let url='/api/users?per_page=100';
  if(q) url+=`&q=${encodeURIComponent(q)}`;
  if(role) url+=`&role=${encodeURIComponent(role)}`;
  const d=await api(url); if(!d)return;
  meSuper=!!(d.me&&d.me.is_superadmin);
  meId=d.me&&d.me.user_id||0;
  const sel=document.getElementById('newRole');
  if(sel && meSuper && !sel.querySelector('option[value="superadmin"]')){
    sel.insertAdjacentHTML('beforeend','<option value="superadmin">超级管理员</option>');
  }
  const editSel=document.getElementById('editUserRole');
  if(editSel && meSuper && !editSel.querySelector('option[value="superadmin"]')){
    editSel.insertAdjacentHTML('beforeend','<option value="superadmin">超级管理员</option>');
  }
  const users=d.items||d.users||d||[];
  _usersCache=users;
  document.getElementById('userTbl').innerHTML=users.length?users.map(u=>{
    const superU=_isSuperRole(u.role);
    const admin=_isAdminRole(u.role);
    const self=Number(u.id)===Number(meId);
    const badge=superU?'badge-y':(admin?'badge-y':'badge-b');
    let actions='';
    if(self){
      actions='<span style="color:var(--text-muted);font-size:.72rem">当前账号</span>';
    } else if(superU){
      actions='<span style="color:var(--text-muted);font-size:.72rem">超管受保护</span>';
    } else if(admin && !meSuper){
      actions='<span style="color:var(--text-muted);font-size:.72rem">受保护</span>';
    } else if(meSuper){
      actions=`<button class="btn btn-p btn-s" onclick="openEditUser(${u.id})">编辑</button>`
        +`<button class="btn btn-g btn-s" onclick="toggleUser(${u.id},${u.status})">${u.status===1?'禁用':'启用'}</button>`
        +(admin
          ?`<button class="btn btn-g btn-s" onclick="setUserRole(${u.id},'user')">降为用户</button>`
          :`<button class="btn btn-g btn-s" onclick="setUserRole(${u.id},'admin')">升为管理员</button>`)
        +`<button class="btn btn-r btn-s" onclick="deleteUser(${u.id})">删除</button>`;
    } else {
      actions=`<button class="btn btn-g btn-s" onclick="toggleUser(${u.id},${u.status})">${u.status===1?'禁用':'启用'}</button>`
        +`<button class="btn btn-r btn-s" onclick="deleteUser(${u.id})">删除</button>`;
    }
    const tg=u.telegram_id?`<span style="color:var(--teal)">TG:${esc(String(u.telegram_id))}</span>`:'';
    const gh=u.github_id?`<span style="color:#a78bfa">GH:${esc(String(u.github_id))}</span>`:'';
    const binds=[tg, gh].filter(Boolean).join(' · ');
    const emailStr=u.email?`<span style="color:var(--text-primary)">${esc(u.email)}</span>`:'<span style="color:var(--text-muted)">-</span>';
    return `<tr>
      <td>${u.id}</td>
      <td><strong>${esc(u.username)}</strong>${binds ? `<div style="font-size:.68rem;color:var(--text-muted);margin-top:2px;">${binds}</div>` : ''}</td>
      <td>${emailStr}</td>
      <td><span class="badge ${badge}">${_roleLabel(u.role)}</span></td>
      <td><strong style="color:var(--teal);font-size:.82rem">${u.points||0}</strong></td>
      <td><span class="badge ${u.status===1?'badge-g':'badge-r'}">${u.status===1?'正常':'禁用'}</span></td>
      <td style="font-size:.72rem">${(u.created_at||'').substring(0,16)}</td>
      <td class="td-actions">${actions}</td>
    </tr>`;
  }).join(''):'<tr><td colspan="8" class="empty">暂无匹配用户</td></tr>';
}
function openEditUser(uid){
  if(!meSuper){show('只有超管可以编辑管理员','error');return;}
  const u=_usersCache.find(x=>Number(x.id)===Number(uid));
  if(!u){show('用户不存在','error');return;}
  if(_isSuperRole(u.role) && Number(u.id)!==Number(meId)){show('不能编辑其他超管','error');return;}
  document.getElementById('editUserId').value=u.id;
  document.getElementById('editUserName').value=u.username||'';
  document.getElementById('editUserRole').value=_isSuperRole(u.role)?'superadmin':(_isAdminRole(u.role)?'admin':'user');
  document.getElementById('editUserStatus').value=String(u.status===0?0:1);
  document.getElementById('editUserTg').value=u.telegram_id||'';
  document.getElementById('editUserPass').value='';
  document.getElementById('editUserTitle').textContent='编辑 · '+ (u.username||uid);
  // 编辑自己时禁止改角色/状态
  const self=Number(u.id)===Number(meId);
  document.getElementById('editUserRole').disabled=self;
  document.getElementById('editUserStatus').disabled=self;
  showModal('editUserModal');
}
