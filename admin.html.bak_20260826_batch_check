<div class="toast-container" id="toastContainer"></div>

<script>
const esc = s => { if(!s)return ''; const div=document.createElement('div'); div.textContent=String(s); return div.innerHTML; };
const fmtN = n => Number(n||0).toLocaleString();

async function api(u,m='GET',d=null){
  const csrf=await(await fetch('/api/csrf-token')).json();
  const o={method:m,headers:{'Content-Type':'application/json','X-CSRF-Token':csrf.csrf_token||''}};
  if(d)o.body=JSON.stringify(d);
  const r=await fetch(u,o);
  if(r.status===401){window.location.href='/';return null}
  const txt=await r.text();
  try{return JSON.parse(txt)}catch(e){return {ok:false,error:txt}}
}

function show(t='',type='success'){
  const c=document.getElementById('toastContainer');
  const el=document.createElement('div'); el.className='toast '+type;
  el.innerHTML='<span>'+esc(t)+'</span><span class="close" onclick="this.parentElement.remove()">×</span>';
  c.appendChild(el); setTimeout(()=>el.remove(),3500);
}

function showModal(id){document.getElementById(id)?.classList.add('show')}
function hideModal(id){document.getElementById(id)?.classList.remove('show')}
function toggleGroup(el){el.parentElement.classList.toggle('collapsed')}
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.querySelector('.side-backdrop').classList.toggle('show');
}

function showSec(id){
  document.querySelectorAll('.page-like, [id^="sec-"]').forEach(s=>s.style.display='none');
  document.getElementById('sec-'+id).style.display='block';
  document.querySelectorAll('.nav').forEach(n=>n.classList.remove('active'));
  const nav=[...document.querySelectorAll('.nav')].find(n=>n.getAttribute('onclick')?.includes("'"+id+"'"));
  if(nav)nav.classList.add('active');
  // 移动端：如果侧边栏打开，则关闭
  if(window.innerWidth<=900 && document.getElementById('sidebar').classList.contains('open'))toggleSidebar();
  const loaders={dashboard:loadDashboard,resources:loadResources,users:loadUsers,import:loadImportQueue,filters:loadFilters,deadlinks:loadDeadlinkStats,duplicates:loadDuplicates,apis:()=>{},announcements:loadAnnouncements,sources:loadSources,settings:loadSettings,logs:loadLogs,searchlogs:loadSearchLogs};
  loaders[id]?.();
}

// 仪表盘
async function loadDashboard(){
  try{
    const [stats,dash,queue]=await Promise.all([api('/api/stats'),api('/api/admin/stats/dashboard'),api('/api/admin/import_queue?status=pending')]);
    const o=dash?.overview||{};
    document.getElementById('sTotal').textContent=fmtN(o.resources||stats?.total||0);
    document.getElementById('sTotalSub').textContent=(o.source_count||0)+' 来源 · '+(o.keyword_count||0)+' 关键词';
    document.getElementById('sVisits').textContent=fmtN(dash?.total_visits||0);
    document.getElementById('sSearches').textContent=fmtN((dash?.daily_searches||[]).length?(dash.daily_searches[dash.daily_searches.length-1].count||0):0);
    document.getElementById('sSearchesSub').textContent='今日搜索';
    document.getElementById('sQueue').textContent=fmtN((queue?.items||[]).length);
    const todayAdd=(dash?.daily_resources||[]).length?dash.daily_resources[dash.daily_resources.length-1].count:0;
    document.getElementById('sTodayAdd').textContent=fmtN(todayAdd);
    document.getElementById('sDead').textContent='-';
    document.getElementById('sDeadSub').textContent='加载中…';
    // deadlink count
    const dl=await api('/api/admin/deadlinks/unchecked_count');
    const deadRes=await api('/api/admin/resources?per_page=1&link_status=dead');
    document.getElementById('sDead').textContent=fmtN((deadRes?.total||0));
    document.getElementById('sDeadSub').textContent=(dl?.total||0)+' 未检测';
    renderTrendChart(dash?.daily_resources||[],dash?.daily_searches||[]);
    renderPieList('sourceChart',dash?.source_dist||[],true);
    renderPieList('typeChart',dash?.type_dist||[],false);
    renderPieList('searchChart',dash?.top_searches||[].map(x=>({source:x.keyword,count:x.count})),false);
    renderGrowth(dash?.growth);
  }catch(e){console.error('dashboard',e);show('仪表盘加载失败','error')}
}

function renderGrowth(g){
  if(!g || g.error){
    document.getElementById('gHint').textContent=g&&g.error?('监测失败：'+g.error):'暂无增长数据';
    return;
  }
  const goal=g.goal||10000;
  const members=g.members;
  document.getElementById('gChat').textContent=g.chat||'未配置必加群';
  document.getElementById('gProgressLbl').textContent=(members==null?'—':fmtN(members))+' / '+fmtN(goal);
  const pct=Math.round((g.progress||0)*100);
  const bar=document.getElementById('gBar');
  bar.style.width=pct+'%';
  bar.classList.toggle('warn', !!g.watery);
  document.getElementById('gMembers').textContent=members==null?'—':fmtN(members);
  document.getElementById('gMembersSub').textContent=g.members_error?g.members_error:(members==null?'无法读取':'距目标还差 '+fmtN(Math.max(0,goal-(members||0))));
  document.getElementById('gChatters').textContent=fmtN(g.group_chatters_7d);
  document.getElementById('gLogins').textContent=fmtN(g.site_logins_7d);
  document.getElementById('gLoginsSub').textContent='今日 '+fmtN(g.site_logins_today);
  document.getElementById('gSearches').textContent=fmtN(g.searches_7d);
  document.getElementById('gSearchesSub').textContent='独立用户 '+fmtN(g.searchers_7d)+' · 今日 '+fmtN(g.searches_today);
  const hint=document.getElementById('gHint');
  hint.classList.remove('warn','ok');
  if(g.members_error && members==null){
    hint.textContent='人数读不到：Bot 需在必加群里且为管理员。7 日群活跃需在 BotFather 关闭隐私模式（/setprivacy → Disable），否则只能看到命令。';
    hint.classList.add('warn');
  }else if(g.watery){
    hint.textContent='人数看起来不少，但近 7 天群发言不到 300 人，水分可能偏大。先清僵尸、养打开率，继续免费引流。';
    hint.classList.add('warn');
  }else if(members!=null && members>=goal){
    hint.textContent='群已过 1 万。现阶段仍只做引流：进群和搜索继续免费，不加锁、不收费、不接广告。';
    hint.classList.add('ok');
  }else{
    const left=Math.max(0,goal-(members||0));
    hint.textContent='内测免费引流中，目标先把群养到 1 万（还差 '+fmtN(left)+'）。搜索保持开放。群活跃从 Bot 收到的群消息统计，需关闭隐私模式。';
  }
}

function renderTrendChart(res,searches){
  const el=document.getElementById('trendChart'); if(!res.length&&!searches.length){el.innerHTML='<div class="empty">暂无数据</div>';return}
  const dates=new Set(); res.forEach(r=>dates.add(r.date)); searches.forEach(s=>dates.add(s.date));
  const labels=Array.from(dates).sort().slice(-14);
  const rdata=labels.map(d=>(res.find(x=>x.date===d)||{}).count||0);
  const sdata=labels.map(d=>(searches.find(x=>x.date===d)||{}).count||0);
  const max=Math.max(...rdata,...sdata,1);
  el.innerHTML='<div style="display:flex;justify-content:space-between;font-size:0.7rem;color:var(--text-muted);margin-bottom:4px"><span>入库</span><span>搜索</span></div>'+
    '<div class="mini-bar" style="height:140px">'+rdata.map((v,i)=>{
      const h1=Math.round(v/max*100); const h2=Math.round(sdata[i]/max*100);
      return '<div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:2px"><div style="width:6px;background:var(--green);border-radius:2px 2px 0 0;height:'+h1+'%"></div><div style="width:6px;background:var(--amber);border-radius:2px 2px 0 0;height:'+h2+'%"></div><div style="font-size:0.55rem;color:var(--text-muted);transform:rotate(-45deg);margin-top:8px;white-space:nowrap">'+labels[i].slice(5)+'</div></div>';
    }).join('')+'</div>';
}

function renderPieList(id,data,useSourceColor){
  const el=document.getElementById(id); if(!data.length){el.innerHTML='<div class="empty">暂无数据</div>';return}
  const total=data.reduce((a,b)=>a+(b.count||0),0);
  const colors=['#2dd4bf','#fbbf24','#58a6ff','#f87171','#a78bfa','#34d399','#fb923c','#60a5fa','#f472b6','#94a3b8'];
  el.innerHTML=data.slice(0,10).map((it,i)=>{
    const name=it.source||it.type||it.keyword||it.name||'其他';
    const c=useSourceColor?getSourceColor(name):colors[i%colors.length];
    const pct=total?Math.round((it.count||0)/total*100)+'%':'0%';
    return '<div class="pie-row"><span class="pie-dot" style="background:'+c+'"></span><span class="pie-name">'+esc(name)+'</span><span class="pie-count">'+fmtN(it.count||0)+'</span><span class="pie-pct">'+pct+'</span></div>';
  }).join('');
}

function getSourceColor(source){
  const colors={quark:'#e4a853',aliyun:'#58a6ff',baidu:'#3fb950',xunlei:'#f85149',tianyi:'#bc8cff','115':'#ff7b72',uc:'#79c0ff',pikpak:'#d2a8ff',guangya:'#2dd4bf',magnet:'#c084fc',thunder:'#22d3ee','123':'#fb923c',yidong:'#4ade80'};
  return colors[source]||'var(--text-muted)';
}

// 资源管理
let resPage=1,resTotal=0,resSelected=new Set();
async function loadResources(page=1){
  resPage=page; resSelected.clear(); updateBatchBtn();
  const q=document.getElementById('resSearch').value.trim();
  const source=document.getElementById('resSource').value;
  const type=document.getElementById('resType').value;
  const quality=document.getElementById('resQuality').value;
  const per_page=20;
  const link_status=document.getElementById('resLinkStatus')?document.getElementById('resLinkStatus').value:'';
  const url='/api/admin/resources?page='+page+'&per_page='+per_page+(q?'&q='+encodeURIComponent(q):'')+(source?'&source='+encodeURIComponent(source):'')+(type?'&type='+encodeURIComponent(type):'')+(quality?'&quality='+encodeURIComponent(quality):'')+(link_status?'&link_status='+encodeURIComponent(link_status):'');
  const d=await api(url); if(!d)return;
  resTotal=d.total_pages||1;
  const items=d.items||[];
  document.getElementById('resTbl').innerHTML=items.length?items.map(r=>{
    const title=(r.title||r.note||'').substring(0,60);
    const statusBadge = r.link_status==='dead' ? '<span class="badge" style="background:#ef4444;color:#fff;padding:2px 6px;border-radius:4px;font-size:0.68rem">❌失效</span>' : r.link_status==='alive' ? '<span class="badge" style="background:#10b981;color:#fff;padding:2px 6px;border-radius:4px;font-size:0.68rem">✅正常</span>' : '<span class="badge" style="background:#64748b;color:#fff;padding:2px 6px;border-radius:4px;font-size:0.68rem">⏳未测</span>';
    return '<tr><td><input type="checkbox" class="res-check" data-id="'+r.id+'" onchange="toggleResCheck('+r.id+')"></td><td>'+r.id+'</td><td class="td-title" title="'+esc(r.title||'')+'">'+esc(title)+' '+statusBadge+'</td><td><span class="badge badge-d">'+esc(r.source||'-')+'</span></td><td>'+esc(r.type||'-')+'</td><td>'+esc(r.quality||'-')+'</td><td>'+esc(r.year||'-')+'</td><td class="td-url" title="'+esc(r.url||'')+'">'+esc(r.url||'-')+'</td><td class="td-actions"><button class="btn btn-p btn-s" onclick="checkResourceOne('+r.id+', this)">🔍测活</button><button class="btn btn-g btn-s" onclick="editResource('+r.id+')">编辑</button><button class="btn btn-r btn-s" onclick="deleteResource('+r.id+')">删除</button></td></tr>';
  }).join(''):'<tr><td colspan="9" class="empty">暂无数据</td></tr>';
  renderPager('resPager',resPage,resTotal,loadResources);
  document.getElementById('resAllCheck').checked=false;
}

function toggleResCheck(id){
  const cb=document.querySelector('.res-check[data-id="'+id+'"]'); if(!cb)return;
  if(cb.checked)resSelected.add(id); else resSelected.delete(id);
  updateBatchBtn();
}
function toggleAllRes(){
  const all=document.getElementById('resAllCheck').checked;
  document.querySelectorAll('.res-check').forEach(cb=>{cb.checked=all; if(all)resSelected.add(parseInt(cb.dataset.id)); else resSelected.delete(parseInt(cb.dataset.id));});
  updateBatchBtn();
}
function updateBatchBtn(){document.getElementById('batchDelBtn').disabled=resSelected.size===0; document.getElementById('batchDelBtn').textContent='批量删除 ('+resSelected.size+')';}

async function deleteResource(id){
  if(!confirm('确定删除该资源？'))return;
  const d=await api('/api/admin/resources/batch','POST',{action:'delete',ids:[id]});
  if(d.ok){show('已删除');loadResources(resPage)}else show(d.error||'删除失败','error');
}
async function batchDeleteResources(){
  if(!resSelected.size||!confirm('确定删除选中的 '+resSelected.size+' 条资源？'))return;
  const d=await api('/api/admin/resources/batch','POST',{action:'delete',ids:[...resSelected]});
  if(d.ok){show('已删除 '+d.affected+' 条');loadResources(1)}else show(d.error||'删除失败','error');
}

async function editResource(id){
  const d=await api('/api/admin/resources?page=1&per_page=1&q='); // no direct get by id, use list workaround
  // try to find from current rendered list (not reliable); use a search by id endpoint fallback
  const r=await api('/api/admin/resources?page=1&per_page=200');
  const item=(r?.items||[]).find(x=>x.id===id);
  if(!item){show('未找到资源','error');return}
  document.getElementById('editResId').value=id;
  document.getElementById('editResTitle').value=item.title||item.note||'';
  document.getElementById('editResUrl').value=item.url||'';
  document.getElementById('editResType').value=item.type||'';
  document.getElementById('editResQuality').value=item.quality||'';
  document.getElementById('editResYear').value=item.year||'';
  const srcSel=document.getElementById('editResSource');
  srcSel.innerHTML='<option value="">未分类</option>'+[...document.getElementById('resSource').options].slice(1).map(o=>'<option value="'+o.value+'">'+o.text+'</option>').join('');
  srcSel.value=item.source||'';
  showModal('resEditModal');
}
async function saveResource(){
  const id=parseInt(document.getElementById('editResId').value);
  const payload={
    title:document.getElementById('editResTitle').value,
    url:document.getElementById('editResUrl').value,
    source:document.getElementById('editResSource').value,
    type:document.getElementById('editResType').value,
    quality:document.getElementById('editResQuality').value,
    year:document.getElementById('editResYear').value
  };
  const d=await api('/api/admin/resources/'+id,'POST',payload);
  if(d.ok||d.success){show('保存成功');hideModal('resEditModal');loadResources(resPage)}else show(d.error||'保存失败','error');
}

async function loadResSources(){
  const d=await api('/api/admin/sources');
  const sel=document.getElementById('resSource');
  const opts=(d?.items||[]).map(s=>'<option value="'+s.name+'">'+esc(s.label||s.name)+'</option>').join('');
  sel.innerHTML='<option value="">全部来源</option>'+opts;
}

function renderPager(id,page,total,cb){
  const el=document.getElementById(id); if(total<=1){el.innerHTML='';return}
  let html='<button onclick="'+cb.name+'('+(page-1)+')" '+(page<=1?'disabled':'')+'>‹</button>';
  const pages=[];
  if(total<=7){for(let i=1;i<=total;i++)pages.push(i)}
  else if(page<=4){for(let i=1;i<=7;i++)pages.push(i)}
  else if(page>=total-3){for(let i=total-6;i<=total;i++)pages.push(i)}
  else {for(let i=page-3;i<=page+3;i++)pages.push(i)}
  pages.forEach(p=>html+='<button class="'+(p===page?'current':'')+'" onclick="'+cb.name+'('+p+')">'+p+'</button>');
  html+='<button onclick="'+cb.name+'('+(page+1)+')" '+(page>=total?'disabled':'')+'>›</button><span class="info">'+page+'/'+total+'页</span>';
  el.innerHTML=html;
}

// 导入队列
let pendingImportKeyword=null;
async function loadImportQueue(){
  const status=document.getElementById('importStatus').value;
  const d=await api('/api/admin/import_queue'+(status?'?status='+status:'')); if(!d)return;
  const items=d.items||[];
  document.getElementById('importTbl').innerHTML=items.length?items.map(q=>{
    const statusMap={done:'badge-g',pending:'badge-y',processing:'badge-b',failed:'badge-r'};
    const statusLabel={done:'完成',pending:'等待',processing:'处理中',failed:'失败'};
    return '<tr><td>'+q.id+'</td><td><strong>'+esc(q.keyword||'')+'</strong></td><td><span class="badge '+(statusMap[q.status]||'badge-b')+'">'+(statusLabel[q.status]||q.status)+'</span></td><td>'+(q.result_count||0)+'条</td><td>'+(q.created_at||'').substring(0,16)+'</td><td class="td-actions">'+(q.status==='pending'||q.status==='failed'?'<button class="btn btn-p btn-s" onclick="previewImport(\''+esc(q.keyword||'')+'\')">预览导入</button>':'')+'<button class="btn btn-r btn-s" onclick="deleteImport('+q.id+')">删除</button></td></tr>';
  }).join(''):'<tr><td colspan="6" class="empty">队列为空</td></tr>';
}
async function previewImport(keyword){
  pendingImportKeyword=keyword;
  showModal('importPreviewModal');
  document.getElementById('importPreviewBody').innerHTML='<div class="empty">正在加载预览…</div>';
  const d=await api('/api/admin/pending_imports');
  // use confirm_import endpoint to fetch a single keyword preview via our own simple API? fallback: simulate by searching from resources
  document.getElementById('importPreviewBody').innerHTML='<div class="empty">预览接口需后端补充；当前直接导入会触发关键词「'+esc(keyword)+'」的搜索入库。</div>';
  // show confirm if preview returns items would be better; for now allow confirm
}
async function confirmImport(){
  if(!pendingImportKeyword)return;
  const d=await api('/api/admin/confirm_import','POST',{keywords:[pendingImportKeyword]});
  if(d.total_imported!=null){show('导入 '+d.total_imported+' 条');hideModal('importPreviewModal');loadImportQueue()}else show(d.error||'导入失败','error');
}
async function deleteImport(id){const d=await api('/api/admin/import_queue/'+id,'DELETE');if(d.ok){show('已删除');loadImportQueue()}}

// 死链

// ──────────────── 新增：后台全量巡检轮询与单资源测活 ────────────────
let _bgScanTimer = null;

async function checkResourceOne(id, btn){
  if(btn){btn.disabled=true; btn.textContent='测活中…';}
  const r = await api('/api/admin/resources/'+id+'/check', 'POST');
  if(r && r.ok){
    const msg = r.link_status==='alive' ? '✅ 链接正常存活' : r.link_status==='dead' ? ('❌ 链接已失效: '+(r.msg||'404')) : '未知状态';
    show(msg, r.link_status==='dead'?'error':'info');
    loadResources(resPage);
  } else {
    show('测活请求失败', 'error');
    if(btn){btn.disabled=false; btn.textContent='🔍测活';}
  }
}

async function startBgScan(){
  const source = document.getElementById('dlSourceFilter').value;
  const r = await api('/api/admin/deadlinks/bg_start', 'POST', {source});
  if(r && r.ok){
    show('全量后台巡检已启动！');
    pollBgScanStatus();
  } else {
    show(r?.msg || '启动失败', 'error');
  }
}

async function stopBgScan(){
  const r = await api('/api/admin/deadlinks/bg_stop', 'POST');
  if(r && r.ok){
    show('已发送停止信号');
    pollBgScanStatus();
  }
}

async function pollBgScanStatus(){
  if(_bgScanTimer) clearTimeout(_bgScanTimer);
  const r = await api('/api/admin/deadlinks/bg_status');
  if(!r || !r.state) return;
  const s = r.state;
  const box = document.getElementById('bgScanProgressBox');
  const startBtn = document.getElementById('bgStartBtn');
  const stopBtn = document.getElementById('bgStopBtn');

  if(s.running || s.scanned > 0){
    if(box) box.style.display = 'block';
    if(startBtn) startBtn.style.display = s.running ? 'none' : 'inline-block';
    if(stopBtn) stopBtn.style.display = s.running ? 'inline-block' : 'none';
    
    const pct = s.total > 0 ? Math.min(100, Math.round((s.scanned / s.total) * 100)) : 0;
    if(document.getElementById('bgScanPct')) document.getElementById('bgScanPct').textContent = pct + '%';
    if(document.getElementById('bgScanBar')) document.getElementById('bgScanBar').style.width = pct + '%';
    if(document.getElementById('bgScanned')) document.getElementById('bgScanned').textContent = s.scanned + ' / ' + s.total;
    if(document.getElementById('bgAlive')) document.getElementById('bgAlive').textContent = s.alive;
    if(document.getElementById('bgDead')) document.getElementById('bgDead').textContent = s.dead;
    if(document.getElementById('bgElapsed')) document.getElementById('bgElapsed').textContent = s.elapsed_s + 's';
    if(document.getElementById('bgScanStatusText')) document.getElementById('bgScanStatusText').textContent = s.running ? '🚀 高速并发巡检进行中…' : '✅ 巡检已完成 / 已暂停';

    if(s.running){
      _bgScanTimer = setTimeout(pollBgScanStatus, 1500);
    } else {
      loadDeadlinkStats();
    }
  } else {
    if(box) box.style.display = 'none';
    if(startBtn) startBtn.style.display = 'inline-block';
    if(stopBtn) stopBtn.style.display = 'none';
  }
}

