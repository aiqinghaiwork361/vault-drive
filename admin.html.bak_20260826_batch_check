async function scanDeadlinks(){
  const source=document.getElementById('dlSourceFilter').value;
  const limit=parseInt(document.getElementById('dlBatchSize').value)||50;
  show('开始扫描…');
  const d=await api('/api/admin/deadlinks/scan','POST',{source,limit,skip_checked:true});
  if(!d)return;
  document.getElementById('dlScanResult').innerHTML='本批扫描 '+d.scanned+' 条：正常 '+d.alive_count+' · 死链 '+d.dead_count+' · 未知 '+d.unknown_count+'（剩余 '+d.total+' 条）';
  if(d.results?.length){
    document.getElementById('dlResultWrap').style.display='block';
    document.getElementById('dlResultTbl').innerHTML=d.results.map(x=>{
      const color=x.status==='dead'?'var(--red)':x.status==='alive'?'var(--green)':'var(--amber)';
      return '<tr><td>'+x.id+'</td><td>'+esc(x.title)+'</td><td>'+esc(x.source)+'</td><td style="color:'+color+'">'+x.status+'</td><td>'+esc(x.msg||'')+'</td></tr>';
