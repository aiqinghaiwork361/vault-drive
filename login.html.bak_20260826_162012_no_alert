async function doLogin() {
  var err = document.getElementById('err');
  var btn = document.querySelector('.btn-login');
  err.style.display = 'none';

  var originalHTML = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '登录中…';
  btn.style.opacity = '0.7';
  btn.style.pointerEvents = 'none';

  try {
    var csrfResp = await fetch('/api/csrf-token');
    var csrfData = await csrfResp.json();
    var csrfToken = csrfData.csrf_token;
    var r = await fetch('/login', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrfToken
      },
      body: JSON.stringify({
        username: document.getElementById('u').value,
        password: document.getElementById('p').value,
        csrf_token: csrfToken,
        next: (function () {
          var m = location.search.match(/[?&]next=([^&]+)/);
          return m ? decodeURIComponent(m[1]) : '/';
        })()
      })
    });
    if (r.ok) {
      var d = await r.json();
      location.href = d.redirect || loginNextUrl(d.role);
    } else {
      var d = await r.json();
      err.style.display = 'block';
      err.textContent = d.error || '登录失败';
      btn.disabled = false;
      btn.innerHTML = originalHTML;
      btn.style.opacity = '';
      btn.style.pointerEvents = '';
    }
  } catch (e) {
    err.style.display = 'block';
    err.textContent = '网络错误，请重试';
    btn.disabled = false;
    btn.innerHTML = originalHTML;
    btn.style.opacity = '';
    btn.style.pointerEvents = '';
  }
}

async function doGithubLogin() {
  var m = location.search.match(/[?&]next=([^&]+)/);
  var next = m ? m[1] : encodeURIComponent('/');
  window.location.href = '/login/github?next=' + next;
}
