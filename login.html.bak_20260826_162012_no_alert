<script>
(function showUrlError() {
  var m = location.search.match(/[?&]error=([^&]+)/);
  if (!m) return;
  var err = document.getElementById('err');
  err.style.display = 'block';
  err.textContent = decodeURIComponent(m[1].replace(/^tg_/, ''));
})();

function loginNextUrl(role) {
  var m = location.search.match(/[?&]next=([^&]+)/);
  var next = '/';
  if (m) {
    try {
      var u = decodeURIComponent(m[1]);
      if (u.startsWith('/') && !u.startsWith('//') && u.indexOf('\\') < 0 && !u.startsWith('/login')) {
        next = u.slice(0, 500);
      }
    } catch (e) {}
  }
  if ((role === 'admin' || role === 'superadmin') && (next === '/' || !next)) return '/admin';
  return next || '/';
}

async function onTelegramAuth(user) {
  var err = document.getElementById('err');
  err.style.display = 'none';
  try {
    var csrfResp = await fetch('/api/csrf-token');
    var csrfData = await csrfResp.json();
    var csrfToken = csrfData.csrf_token;
    var r = await fetch('/login/telegram', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrfToken
      },
      body: JSON.stringify(Object.assign({}, user, { csrf_token: csrfToken }))
    });
    var d = await r.json();
    if (r.ok && d.ok) {
      location.href = loginNextUrl(d.role);
    } else {
      err.style.display = 'block';
      err.textContent = d.error || 'Telegram 登录失败';
    }
  } catch (e) {
    err.style.display = 'block';
    err.textContent = '网络错误，请重试';
  }
}
window.onTelegramAuth = onTelegramAuth;

var _tgLoginPoll = null;
async function startTelegramBotLogin() {
  var err = document.getElementById('err');
  var hint = document.getElementById('tgHint');
  var btn = document.getElementById('tgBotLoginBtn');
  err.style.display = 'none';
  try {
    if (btn) { btn.disabled = true; btn.textContent = '打开 Bot 中…'; }
    var csrfResp = await fetch('/api/csrf-token');
    var csrfData = await csrfResp.json();
    var r = await fetch('/api/auth/telegram/login-code', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrfData.csrf_token || ''
      },
      body: '{}'
    });
    var d = await r.json();
    if (d.already) {
      location.href = loginNextUrl();
      return;
    }
    if (!r.ok || !d.ok) {
      err.style.display = 'block';
      err.textContent = d.error || '无法启动 Telegram 登录';
      if (btn) { btn.disabled = false; btn.textContent = '使用 Telegram 登录'; }
      return;
    }
    if (hint) {
      hint.innerHTML = '请在 Telegram 打开 <a href="' + d.deep_link + '" target="_blank" rel="noopener">@' + d.bot_username + '</a> 确认登录<br>确认后本页会自动跳转';
    }
    if (btn) {
      btn.disabled = false;
      btn.textContent = '再次打开 Bot';
      btn.onclick = function () { window.open(d.deep_link, '_blank', 'noopener'); };
    }
    window.open(d.deep_link, '_blank', 'noopener');
    if (_tgLoginPoll) clearInterval(_tgLoginPoll);
    var n = 0;
    _tgLoginPoll = setInterval(async function () {
      n += 1;
      try {
        var pr = await fetch('/api/auth/telegram/login-poll?code=' + encodeURIComponent(d.code));
        var pd = await pr.json();
        if (pd.status === 'ready') {
          clearInterval(_tgLoginPoll);
          var csrf2 = await fetch('/api/csrf-token').then(function (x) { return x.json(); });
          var cr = await fetch('/api/auth/telegram/login-complete', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRFToken': csrf2.csrf_token || ''
            },
            body: JSON.stringify({ code: d.code })
          });
          var cd = await cr.json();
          if (cr.ok && cd.ok) {
            location.href = loginNextUrl(cd.role);
          } else {
            err.style.display = 'block';
            err.textContent = cd.error || '登录完成失败';
            if (btn) btn.textContent = '使用 Telegram 登录';
          }
        } else if (pd.status === 'expired') {
          clearInterval(_tgLoginPoll);
          if (hint) hint.textContent = '登录码已过期，请重新点击 Telegram 登录';
          if (btn) {
            btn.textContent = '使用 Telegram 登录';
            btn.onclick = startTelegramBotLogin;
          }
        }
      } catch (e) {}
      if (n >= 100) clearInterval(_tgLoginPoll);
    }, 2000);
  } catch (e) {
    err.style.display = 'block';
    err.textContent = '网络错误，请重试';
    if (btn) { btn.disabled = false; btn.textContent = '使用 Telegram 登录'; }
  }
}

async function initTelegramLogin() {
  // 只用 Bot 深链登录，不挂官方 Login Widget（未 /setdomain 时会露出「Bot domain invalid」）
  var hint = document.getElementById('tgHint');
  try {
    var r = await fetch('/api/telegram/login-config');
    var cfg = await r.json();
    if (!cfg.enabled || !cfg.bot_username) {
      var btn = document.getElementById('tgBotLoginBtn');
      if (btn) btn.disabled = true;
      if (hint) hint.textContent = cfg.hint || 'Telegram 登录未启用（需配置 Bot）';
      return;
    }
    var loginBot = cfg.login_bot || cfg.bot_username || 'vaultdrive_bot';
    var btn = document.getElementById('tgBotLoginBtn');
    if (btn) btn.textContent = '使用 Telegram 登录 @' + loginBot;
    if (hint && cfg.required_chat_link) {
      hint.innerHTML = '登录走 <a href="https://t.me/' + loginBot + '" target="_blank" rel="noopener">@' + loginBot + '</a> · 仅 <a href="' + cfg.required_chat_link + '" target="_blank" rel="noopener">' + (cfg.required_chat || '指定群') + '</a> 成员可登录';
    }
    var g = cfg.growth;
    if (g) {
      var set = function(id, href, text) {
        var el = document.getElementById(id);
        if (!el || !href) return;
        el.href = href;
        if (text) el.textContent = text;
      };
      set('gGroup', g.group_link, '进群');
      set('gChannel', g.channel_link, g.channel);
      set('gChannelBtn', g.channel_link, '频道');
      set('gBot', g.search_bot_link, g.search_bot);
      set('gBotBtn', g.search_bot_link, '搜片 Bot');
      set('gSite', g.site, g.site);
      set('gSiteBtn', g.site, '网站');
    }
  } catch (e) {
    if (hint) hint.textContent = '';
  }
}
initTelegramLogin();

var currentAuthMode = 'login';
var _sendCodeCountdown = 0;
var _sendCodeTimer = null;

function switchAuthTab(mode) {
  currentAuthMode = mode;
  var tabL = document.getElementById('tabLogin');
  var tabR = document.getElementById('tabRegister');
  var btn = document.getElementById('authSubmitBtn');
  var loginFields = document.getElementById('loginFields');
  var registerFields = document.getElementById('registerFields');
  var err = document.getElementById('err');
  if (err) err.style.display = 'none';

  if (mode === 'register') {
    tabL.style.background = 'transparent';
    tabL.style.color = 'var(--muted)';
    tabR.style.background = 'var(--teal)';
    tabR.style.color = '#000';
    btn.textContent = '立即注册并登录 (+100积分)';
    loginFields.style.display = 'none';
    registerFields.style.display = 'block';
    document.getElementById('regEmail').focus();
  } else {
    tabL.style.background = 'var(--teal)';
    tabL.style.color = '#000';
    tabR.style.background = 'transparent';
    tabR.style.color = 'var(--muted)';
    btn.textContent = '登录';
    loginFields.style.display = 'block';
    registerFields.style.display = 'none';
    document.getElementById('u').focus();
  }
}

async function sendEmailCode() {
  var email = document.getElementById('regEmail').value.trim();
  var err = document.getElementById('err');
  var btn = document.getElementById('btnSendCode');
  if (err) err.style.display = 'none';

  if (!email || !email.includes('@')) {
    err.style.display = 'block';
    err.textContent = '请输入有效的电子邮箱';
    return;
  }
  if (_sendCodeCountdown > 0) return;

  btn.disabled = true;
  btn.textContent = '发送中…';

  try {
    var r = await fetch('/api/auth/email/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, action: 'register' })
    });
    var d = await r.json();
    if (r.ok && d.ok) {
      err.style.display = 'none';
      _sendCodeCountdown = 60;
      btn.textContent = _sendCodeCountdown + 's';
      if (_sendCodeTimer) clearInterval(_sendCodeTimer);
      _sendCodeTimer = setInterval(function() {
        _sendCodeCountdown--;
        if (_sendCodeCountdown <= 0) {
          clearInterval(_sendCodeTimer);
          btn.disabled = false;
          btn.textContent = '重新获取';
        } else {
          btn.textContent = _sendCodeCountdown + 's';
        }
      }, 1000);
      alert('验证码已发送至 ' + email + '，请查收（若未收到请检查垃圾箱）');
      document.getElementById('regCode').focus();
    } else {
      err.style.display = 'block';
      err.textContent = d.error || '验证码发送失败';
      btn.disabled = false;
      btn.textContent = '获取验证码';
    }
  } catch(e) {
    err.style.display = 'block';
    err.textContent = '网络错误，请重试';
    btn.disabled = false;
    btn.textContent = '获取验证码';
  }
}

async function handleAuthSubmit() {
  if (currentAuthMode === 'register') {
    await doEmailRegister();
  } else {
    await doLogin();
  }
}

async function doEmailRegister() {
  var err = document.getElementById('err');
  var btn = document.getElementById('authSubmitBtn');
  var email = document.getElementById('regEmail').value.trim();
  var code = document.getElementById('regCode').value.trim();
  var pwd = document.getElementById('regPwd').value.trim();

  if (!email || !code || !pwd) {
    err.style.display = 'block';
    err.textContent = '请填写邮箱、6位验证码及密码';
    return;
  }
  if (pwd.length < 6) {
    err.style.display = 'block';
    err.textContent = '密码至少需要 6 个字符';
    return;
  }

  err.style.display = 'none';
  btn.disabled = true;
  btn.textContent = '注册中…';

  try {
    var r = await fetch('/api/auth/email/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: email,
        code: code,
        password: pwd,
        next: (function () {
          var m = location.search.match(/[?&]next=([^&]+)/);
          return m ? decodeURIComponent(m[1]) : '';
        })()
      })
    });
    var d = await r.json();
    if (r.ok && d.ok) {
      location.href = d.redirect || loginNextUrl(d.role || 'user');
    } else {
      err.style.display = 'block';
      err.textContent = d.error || '注册失败';
      btn.disabled = false;
      btn.textContent = '立即注册并登录 (+100积分)';
    }
  } catch (e) {
    err.style.display = 'block';
    err.textContent = '网络请求失败，请重试';
    btn.disabled = false;
    btn.textContent = '立即注册并登录 (+100积分)';
  }
}

