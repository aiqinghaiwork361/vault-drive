# VaultDrive / resource_web 配置模板（可提交到 Git）
# 复制为 .env 后填入真实值：  cp .env.example .env
# 警告：.env 含密钥，禁止提交；本文件只放占位符

# ---------- 基础 ----------
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=change-me-admin-password
TZ=Asia/Shanghai
SESSION_COOKIE_NAME=resource_web_dev_session

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=resource_user
DB_PASSWORD=change-me-db-password
DB_NAME=pan_resource

# ---------- Redis ----------
REDIS_HOST=resource_web_redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------- 第三方 ----------
TMDB_API_KEY=
TRAKT_CLIENT_ID=
SEARCH_API=

# ---------- GitHub OAuth（可选） ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:5000/login/github/callback
# GITHUB_HTTP_PROXY=http://127.0.0.1:7890

# ---------- Telegram 登录 / Bot（可选） ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_MAX_AGE=86400
TELEGRAM_REQUIRED_CHAT=
# TELEGRAM_SUPERADMIN_IDS=
# TELEGRAM_WEBHOOK_BASE=
# TELEGRAM_WEBHOOK_SECRET=

# ---------- 出站代理（可选） ----------
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
